#include <stdio.h>
#include <stdlib.h>
struct Node {
    int data;
    struct Node* next;
};

struct Node* createNode(int value) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    if (newNode == NULL) {
        printf("Memory allocation failed!\n");
        exit(1);
    }
    newNode->data = value;
    newNode->next = NULL;
    return newNode;
}
void insertAtBeginning(struct Node** headRef, int value) {
    struct Node* newNode = createNode(value);
    newNode->next = *headRef;
    *headRef = newNode;
}
void insertAtEnd(struct Node** headRef, int value) {
    struct Node* newNode = createNode(value);
    if (*headRef == NULL) {
        *headRef = newNode;
        return;
    }
    struct Node* temp = *headRef;
    while (temp->next != NULL) {
        temp = temp->next;
    }
    temp->next = newNode;
}
void insertAtMiddle(struct Node** headRef, int value, int position) {
    if (position == 0) {
        insertAtBeginning(headRef, value);
        return;
    }

    struct Node* temp = *headRef;
    for (int i = 0; temp != NULL && i < position - 1; i++) {
        temp = temp->next;
    }
    if (temp == NULL) {
        printf("Position out of bounds! Inserting at the end instead.\n");
        insertAtEnd(headRef, value);
        return;
    }

    struct Node* newNode = createNode(value);
    newNode->next = temp->next;
    temp->next = newNode;
}
void deleteAtBeginning(struct Node** headRef) {
    if (*headRef == NULL) {
        printf("List is empty. Nothing to delete.\n");
        return;
    }

    struct Node* temp = *headRef;
    *headRef = (*headRef)->next;
    free(temp);
}
void deleteAtEnd(struct Node** headRef) {
    if (*headRef == NULL) {
        printf("List is empty. Nothing to delete.\n");
        return;
    }

    struct Node* temp = *headRef;
    if (temp->next == NULL) {
        *headRef = NULL;
        free(temp);
        return;
    }
    while (temp->next->next != NULL) {
        temp = temp->next;
    }

    free(temp->next);
    temp->next = NULL;
}
void deleteAtMiddle(struct Node** headRef, int position) {
    if (*headRef == NULL) {
        printf("List is empty. Nothing to delete.\n");
        return;
    }
    if (position == 0) {
        deleteAtBeginning(headRef);
        return;
    }

    struct Node* temp = *headRef;
    for (int i = 0; temp != NULL && i < position - 1; i++) {
        temp = temp->next;
    }
    if (temp == NULL || temp->next == NULL) {
        printf("Position out of bounds. Deletion ignored.\n");
        return;
    }

    struct Node* nodeToDelete = temp->next;
    temp->next = temp->next->next;
    free(nodeToDelete);
}
void printList(struct Node* head) {
    struct Node* temp = head;
    while (temp != NULL) {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }
    printf("NULL\n");
}

int main() {
    struct Node* head = NULL;

    printf("--- Insertion Operations ---\n");
    insertAtBeginning(&head, 200);
    insertAtBeginning(&head, 100);
    printList(head);

    insertAtEnd(&head, 400);
    insertAtEnd(&head, 50);
    printList(head); 

    insertAtMiddle(&head, 390, 2);
    printList(head);

    printf("\n--- Deletion Operations ---\n");
    deleteAtBeginning(&head);
    printList(head);

    deleteAtEnd(&head);
    printList(head);

    deleteAtMiddle(&head, 1);
    printList(head); 

    return 0;
}
